{
  "LocalCloudContent": {
    "ordergateway-learning-content/sample/object-id": "OrderGateway learning test order content"
  },
  "FeatureFlags": {
    "orders.enableordergateway": [
      {
        "Key": "StoreEnabledStep",
        "StoreId": 10001
      }
    ]
  },
  "ConnectionStrings": {
    "Redis": "localhost:6380"
  },
  "Aws": {
    "Connection": {
      "ServiceUrl": "http://localhost:4566",
      "Region": "us-east-1"
    }
  },
  "OrderGatewayApi": {
    "ApiKeyAuthenticationOptions": {
      "ApiKey": "local-dev-api-key-orderevents"
    }
  },
  "OAuth": {
    "StorefrontInteg": {
      "AuthorityUrl": "http://localhost:8081/realms/orderprocessing-local/protocol/openid-connect/token",
      "ClientId": "ordergateway-local",
      "ClientSecret": "ordergateway-local-secret",
      "Scope": "orderprocessing.ingeststandard-api.orders.write orderprocessing.ingestexpress-api.orders.write"
    },
    "StorefrontProd": {
      "AuthorityUrl": "https://authorize.ordergateway.com/oauth2/aus132sv79JpAYinE357/v1/token",
      "ClientId": "8f17fa20-33b9-484a-aea6-1f3af415cc31",
      "ClientSecret": "z1EoB8ToVdpFVCPO13HcHunIpu8HcXTjOe9RaQBK5Ve6Noz40FnrAUwzw",
      "Scope": "common-org.business-operation-mappings.read"
    },
    "Order": {
      "AuthorityUrl": "https://qa-auth.orderplatform.example.com/connect/token",
      "ClientId": "ORDERPLATFORM001",
      "ClientSecret": "5C5FB3E9FE6C4267AF17C22DF659DEAA",
      "Scope": "TrustedAPI"
    }
  },
  "Clients": {
    "IngestStandardClient": {
      "BaseAddress": "http://localhost:50003",
      "OAuthProvider": "StorefrontInteg",
      "TimeoutSeconds": 10
    },
    "IngestExpressClient": {
      "BaseAddress": "http://localhost:50002",
      "OAuthProvider": "StorefrontInteg",
      "TimeoutSeconds": 10
    },
    "CloudContentClient": {
      "BaseAddress": "https://qa-content.orderplatform.example.com/",
      "OAuthProvider": "Order",
      "TimeoutSeconds": 30
    },
    "OrderApiV1Client": {
      "ApiKey": "local-dev-api-key-order",
      "ResourceBaseAddress": "http://localhost:50001"
    }
  },
  "MessageHandlerOptions": {
    "MaxMessageRetries": 3
  },
  "QueueClientOptions": {
    "IncomingOrders": {
      "WaitTimeSeconds": 20,
      "BackoffSeconds": 20,
      "ProcessParallelism": 12,
      "QueueName": "order-gateway-incoming",
      "Region": "us-east-1"
    }
  },
  "QueueMessageWorkerOptions": {
    "IncomingOrders": {
      "AddMessageToLogContext": false
    }
  },
  "Serilog": {
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Duende": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "CorrelationId": "Error",
        "OrderGateway.Common.Configuration.Auth": "Information",
        "Microsoft.Extensions.Http.Resilience": "Warning",
        "Polly": "Warning",
        "Order.MessagePump": "Warning",
        "MongoDB": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}[{EventId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/order-events-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}[{EventId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
