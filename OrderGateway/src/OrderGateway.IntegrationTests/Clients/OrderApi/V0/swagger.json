    "/api/redis/locks/acquire": {
      "post": {
        "tags": [
          "RedisCache"
        ],
        "summary": "Test helper: acquires a customer lock.\r\nReturns the lock fields required to later release the lock via M:OrderHub.Api.Controllers.V0.RedisCacheController.ReleaseLock(OrderHub.Contracts.Utility.RedisLockReleaseRequest).",
        "description": "Uses the same lock mechanism as the message workers (via Order.MessagePump.Locks.ILockManager).",
        "operationId": "AcquireLockRedisCache",
        "requestBody": {
          "description": "Customer id to lock, plus an optional TTL.",
          "content": {
            "application/vnd.order.v0+json": {
              "schema": {
                "$ref": "#/components/schemas/RedisLockAcquireRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Order-Media-Type": {
                "description": "The major API version and format information.",
                "schema": {
                  "type": "string"
                },
                "example": "order.v1; format=json"
              }
            },
            "content": {
              "application/vnd.order.v0+json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisLockAcquireResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "headers": {
              "X-Order-Media-Type": {
                "description": "The major API version and format information.",
                "schema": {
                  "type": "string"
                },
                "example": "order.v1; format=json"
              }
            },
            "content": {
              "application/vnd.order.v0+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyPolicy": [ ]
          }
        ]
      }
    },
