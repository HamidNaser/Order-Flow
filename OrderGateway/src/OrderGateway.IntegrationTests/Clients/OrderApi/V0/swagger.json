  "components": {
    "schemas": {
      "AddDigitalOrderRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderRequest"
          },
          {
            "required": [
              "fromPhoneNumber",
              "toPhoneNumber"
            ],
            "type": "object",
            "properties": {
              "toPhoneNumber": {
                "minLength": 1,
                "type": "string",
                "description": "The recipient's phone number for the text order.\r\n<remarks>\r\nAny valid (not reserved/special) phone number. See examples.</remarks>",
                "example": "(616) 323-4454 or +13234345676 or 616-676-9087 or +1 616-676-9087"
              },
              "fromPhoneNumber": {
                "minLength": 1,
                "type": "string",
                "description": "The sender's phone number for the text order.\r\n<remarks>\r\nAny valid (not reserved/special) phone number. See examples.</remarks>",
                "example": "(616) 323-4454 or +13234345676 or 616-676-9087 or +1 616-676-9087"
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "The text order request model for the ingestion APIs.\r\n<remarks>\r\nThis model inherits common order properties from the base OrderRequest model.\r\nA text order requires Content.</remarks>"
      },
      "AddShipmentOrderRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderRequest"
          },
          {
            "required": [
              "from",
              "to"
            ],
            "type": "object",
            "properties": {
              "to": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AddressInfo"
                },
                "description": "The list of `To` recipients for the shipment order.\r\n<remarks>\r\nEach object in this array must contain a recipient's address.\r\nEach object in the array may optionally contain a recipient's display name.</remarks>"
              },
              "from": {
                "$ref": "#/components/schemas/AddressInfo"
              },
              "orderTitle": {
                "type": "string",
                "description": "The title or heading for the shipment order.\r\n<remarks>\r\nThe order body is set using the Content field.</remarks>",
                "nullable": true,
                "example": "Re: I'd like to buy this car."
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "The shipment order request model for the ingestion APIs.\r\n<remarks>\r\nThis model inherits common order properties from the base OrderRequest model.</remarks>"
      },
      "AddressInfo": {
        "required": [
          "address"
        ],
        "type": "object",
        "properties": {
          "address": {
            "minLength": 1,
            "type": "string",
            "description": "The address for a party (sender or recipient) tied to the shipment order.",
            "example": "test123@domainname.com"
          },
          "name": {
            "type": "string",
            "description": "An optional display name for a party (sender or recipient) tied to the shipment order.\r\n<remarks>\r\nThe field is a component of the RFC 5322 mailbox format.\r\nRFC 5322 mailbox format examples with `Name` in bold...<list><item><description>\"<b>John Doe</b>\" <john.doe@domainname.com></description></item><item><description>\"<b>Smith, Jane (CAI - Atlanta)</b>\" <jane.smith@domainname.com></description></item></list>\r\nThis value should NOT include the wrapping double quotes. Please omit them as this will be handled automatically.</remarks>",
            "nullable": true,
            "example": "\"John Doe\" or \"Smith, Jane (CAI - Atlanta)\""
          }
        },
        "additionalProperties": false
      },
      "FulfillmentStatus": {
        "enum": [
          "SUCCESS",
          "IN_PROGRESS",
          "FAILURE"
        ],
        "type": "string",
        "description": "Represents the current delivery status of a order message.\r\n<remarks>\r\nWhen set to `SUCCESS`, the OrderFulfilledDate field is required.</remarks>"
      },
      "HttpValidationProblemDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "type": "object",
            "properties": {
              "errors": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "nullable": true
              }
            },
            "additionalProperties": { }
          }
        ]
      },
      "Merchant": {
        "required": [
          "name",
          "orderId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/MerchantName"
          },
          "orderId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string",
            "description": "The unique identifier for this order in the merchant's system."
          },
          "sourceApplication": {
            "type": "string",
            "description": "Name of the source application that initiated this order request from the Merchant.",
            "nullable": true,
            "example": "Mobile App, Desktop App"
          }
        },
        "additionalProperties": false,
        "description": "Contains information about the merchant and source of the order."
      },
      "MerchantName": {
        "enum": [
          "PRIME",
          "FRESH",
          "INTEGRATION_TEST"
        ],
        "type": "string",
        "description": "Identifies the order merchant or source system that handled the order."
      },
      "OrderFlowType": {
        "enum": [
          "INCOMING",
          "OUTGOING"
        ],
        "type": "string",
        "description": "Specifies the direction of order flow between the business and the customer.\r\n<remarks>\r\nFrom the user perspective:<list type=\"bullet\"><item><description>`INCOMING` - From the customer; To the user.</description></item><item><description>`OUTGOING` - From the user; To the customer.</description></item></list></remarks>"
      },
      "OrderRequest": {
        "required": [
          "customerId",
          "fulfillmentStatus",
          "merchant",
          "orderFlow",
          "orderPlacedDate",
          "storeId"
        ],
        "type": "object",
        "properties": {
          "storeId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "The unique identifier for the common organization (store).",
            "example": "bf11a6b9-b991-4360-ba46-f82e23a3273d, CoOrgTestId1, CoOrgTestId2"
          },
          "customerId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "The unique identifier for the customer (connected customer) involved in this order.",
            "example": "bf11a6b9-b991-4360-ba46-f82e23a3273d"
          },
          "customerName": {
            "type": "string",
            "description": "The full name of the customer pertaining to this order.",
            "nullable": true,
            "example": "John Smith"
          },
          "agentId": {
            "type": "string",
            "description": "The unique identifier for the common user (bridge) involved in this order.",
            "nullable": true,
            "example": "BRIDGE_ID123"
          },
          "agentName": {
            "type": "string",
            "description": "The full name of the common user.",
            "nullable": true,
            "example": "Jane Smith"
          },
          "orderFlow": {
            "$ref": "#/components/schemas/OrderFlowType"
          },
          "content": {
            "type": "string",
            "description": "The primary content of the order. Common content field between all order types.\r\n<remarks><list type=\"bullet\"><item><description>`STANDARD` - standard order content</description></item><item><description>`TEXT` - digital order content</description></item></list></remarks>",
            "nullable": true
          },
