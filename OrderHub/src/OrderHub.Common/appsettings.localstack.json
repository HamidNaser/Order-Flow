{
  "EncryptedConfiguration": {
    "Keys": []
  },
  "FeatureFlags": {
    "order-api.ingestion.enabledemo": [
      {
        "Key": "DemoOrderController",
        "CommonOrgId": "CoOrgTestId1"
      }
    ]
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "MongoDB": "mongodb://127.0.0.1:27018/?directConnection=true"
  },
  "DatabaseLoggingEnabled": true,
  "Locking": {
    "TtlSeconds": 5
  },
  "Aws": {
    "Connection": {
      "ServiceUrl": "http://localhost:4566",
      "Region": "us-east-1"
    }
  },
  "OrderApi": {
    "ApiKeyAuthenticationOptions": {
      "ApiKey": "local-dev-api-key-orders"
    },
    "BridgeOAuthSettings": {
      "Audience": "non-production-resources",
      "Authority": "http://localhost:8081/realms/orderprocessing-local",
      "Policies": [
        {
          "Name": "ReadOrdersPolicy",
          "Scopes": [ "orderprocessing.order-api.orders.read" ]
        }
      ]
    }
  },
  "IngestExpressApi": {
    "BridgeOAuthSettings": {
      "Audience": "non-production-resources",
      "Authority": "http://localhost:8081/realms/orderprocessing-local",
      "Policies": [
        {
          "Name": "IngestExpressOrdersPolicy",
          "Scopes": [ "orderprocessing.ingestexpress-api.orders.write" ]
        }
      ]
    }
  },
  "IngestStandardApi": {
    "BridgeOAuthSettings": {
      "Audience": "non-production-resources",
      "Authority": "http://localhost:8081/realms/orderprocessing-local",
      "Policies": [
        {
          "Name": "IngestStandardOrdersPolicy",
          "Scopes": [ "orderprocessing.ingeststandard-api.orders.write" ]
        },
        {
          "Name": "IngestStandardCustomerPolicy",
          "Scopes": [ "orderprocessing.ingeststandard-api.customer-event.write" ]
        }
      ]
    }
  },
  "QueueClientOptions": {
    "EXPRESS": {
      "QueueName": "order-hub-express-order",
      "Region": "us-east-1",
      "WaitTimeSeconds": 20
    },
    "STANDARD": {
      "QueueName": "order-hub-standard-order",
      "Region": "us-east-1",
      "WaitTimeSeconds": 20
    }
  },
  "MessageHandlerOptions": {
    "MaxMessageRetries": 3
  },
  "QueueMessageWorkerOptions": {
    "EXPRESS": {
      "AddMessageToLogContext": false,
      "BackoffSeconds": 5,
      "ProcessParallelism": 3
    },
    "STANDARD": {
      "AddMessageToLogContext": false,
      "BackoffSeconds": 5,
      "ProcessParallelism": 3
    }
  },
  "S3Config": {
    "OrderBucketName": "localstack-us-east-1-orders"
  },
  "Serilog": {
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "CorrelationId": "Error",
        "OrderHub.Common.Configuration.Auth": "Information",
        "Order.MessagePump": "Warning",
        "MongoDB": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}[{EventId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/order-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}[{EventId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
