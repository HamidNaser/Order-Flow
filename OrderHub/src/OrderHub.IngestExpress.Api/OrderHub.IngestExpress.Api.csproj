<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>8ac250ea-eb62-482d-8e9f-fef9d28e0e51</UserSecretsId>
        <AssemblyName>OrderHub.IngestExpress.Api</AssemblyName>
        <RootNamespace>OrderHub.IngestExpress.Api</RootNamespace>
        <DocumentationFile>OrderHubIngestExpressApi.xml</DocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\OrderHub.Common\OrderHub.Common.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\OrderHub.Common\appsettings.*.json" Link="%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
