{
  "openapi": "3.0.4",
  "info": {
    "title": "IngestExpressApi",
    "description": "A dedicated API for ingesting express priority orders.",
    "version": "1.0"
  },
  "paths": {
    "/api/order/text": {
      "post": {
        "tags": [
          "Order"
        ],
        "operationId": "AddTextOrder",
        "requestBody": {
          "content": {
            "application/vnd.order.v1+json": {
              "schema": {
                "$ref": "#/components/schemas/AddTextOrderRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "headers": {
              "X-Order-Media-Type": {
                "description": "The major API version and format information.",
                "schema": {
                  "type": "string"
                },
                "example": "order.v1; format=json"
              }
            },
            "content": {
              "application/vnd.order.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "headers": {
              "X-Order-Media-Type": {
                "description": "The major API version and format information.",
                "schema": {
                  "type": "string"
                },
                "example": "order.v1; format=json"
              }
            },
            "content": {
              "application/vnd.order.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "headers": {
              "X-Order-Media-Type": {
                "description": "The major API version and format information.",
                "schema": {
                  "type": "string"
                },
                "example": "order.v1; format=json"
              }
            },
            "content": {
              "application/vnd.order.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "headers": {
              "X-Order-Media-Type": {
                "description": "The major API version and format information.",
                "schema": {
                  "type": "string"
                },
                "example": "order.v1; format=json"
              }
            },
            "content": {
              "application/vnd.order.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "RawToken": [ ]
          }
        ]
      }
    },
