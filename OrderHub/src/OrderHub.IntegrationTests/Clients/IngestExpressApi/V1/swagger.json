  "components": {
    "schemas": {
      "AddCallOrderRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderRequest"
          },
          {
            "required": [
              "callResult",
              "fromPhoneNumber",
              "toPhoneNumber"
            ],
            "type": "object",
            "properties": {
              "toPhoneNumber": {
                "minLength": 1,
                "type": "string"
              },
              "fromPhoneNumber": {
                "minLength": 1,
                "type": "string"
              },
              "recordingDeepLink": {
                "type": "string",
                "nullable": true
              },
              "transcriptDeepLink": {
                "type": "string",
                "nullable": true
              },
              "callResult": {
                "$ref": "#/components/schemas/CallResult"
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "The call order request model for the ingestion APIs.\r\n<remarks>\r\nThis model inherits common order properties from the base OrderRequest model.</remarks>"
      },
      "AddShipmentOrderRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderRequest"
          },
          {
            "required": [
              "from",
              "to"
            ],
            "type": "object",
            "properties": {
              "to": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AddressInfo"
                },
                "description": "The list of `To` recipients for the shipment order.\r\n<remarks>\r\nEach object in this array must contain a recipient's address.\r\nEach object in the array may optionally contain a recipient's display name.</remarks>"
              },
              "from": {
                "$ref": "#/components/schemas/AddressInfo"
              },
              "orderTitle": {
                "type": "string",
                "description": "The title or heading for the shipment order.\r\n<remarks>\r\nThe order body is set using the Content field.</remarks>",
                "nullable": true,
                "example": "Re: I'd like to buy this car."
              },
              "attachments": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AttachmentMetadata"
                },
                "description": "List of file attachment metadata included with the shipment order.\r\n<remarks>\r\nThis metadata will persist; however, there currently is not an upload attachment workflow to correlate.\r\nIt is recommended to not populate this at this time.</remarks>",
                "nullable": true
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "The shipment order request model for the ingestion APIs.\r\n<remarks>\r\nThis model inherits common order properties from the base OrderRequest model.</remarks>"
      },
      "AddTextOrderRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderRequest"
          },
          {
            "required": [
              "fromPhoneNumber",
              "toPhoneNumber"
            ],
            "type": "object",
            "properties": {
              "toPhoneNumber": {
                "minLength": 1,
                "type": "string",
                "description": "The recipient's phone number for the text order.\r\n<remarks>\r\nAny valid (not reserved/special) phone number. See examples.</remarks>",
                "example": "(616) 323-4454 or +13234345676 or 616-676-9087 or +1 616-676-9087"
              },
              "fromPhoneNumber": {
                "minLength": 1,
                "type": "string",
                "description": "The sender's phone number for the text order.\r\n<remarks>\r\nAny valid (not reserved/special) phone number. See examples.</remarks>",
                "example": "(616) 323-4454 or +13234345676 or 616-676-9087 or +1 616-676-9087"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AttachmentMetadata"
                },
                "description": "List of file attachment metadata included with the text order.\r\n<remarks>\r\nThis metadata will persist; however, there currently is not an upload attachment workflow to correlate.\r\nIt is recommended to not populate this at this time.</remarks>",
                "nullable": true
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "The text order request model for the ingestion APIs.\r\n<remarks>\r\nThis model inherits common order properties from the base OrderRequest model.\r\nA text order requires Content or at least one Attachment.</remarks>"
      },
      "AttachmentMetadata": {
        "required": [
          "contentType",
          "filename"
        ],
        "type": "object",
        "properties": {
          "contentType": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "The MIME content type of the attached file.",
            "example": "application/pdf"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string",
            "description": "The original filename of the attached file, including the file extension.",
            "example": "service_invoice.pdf"
          }
        },
        "additionalProperties": false,
        "description": "Represents metadata information for a file attachment included with a order."
      },
      "AttachmentUploadInfo": {
        "required": [
          "attachmentId",
          "contentType",
          "filename",
          "presignedUrl"
        ],
        "type": "object",
        "properties": {
          "presignedUrl": {
            "minLength": 1,
            "type": "string",
            "description": "S3 pre-signed PUT URL for uploading attachment binary content. Valid for configured duration (default 24 hours).",
            "example": "https://s3.amazonaws.com/bucket/key?X-Amz-Algorithm=..."
          },
          "attachmentId": {
            "minLength": 1,
            "type": "string",
            "description": "Unique identifier for this attachment (GUID). Store this value to reference the attachment later."
          },
          "filename": {
            "minLength": 1,
            "type": "string",
            "description": "Original filename from the request attachment metadata."
          },
          "contentType": {
            "minLength": 1,
            "type": "string",
            "description": "MIME type (e.g., application/pdf, image/png) for the attachment. Must match Content-Type header when PUTing to presigned URL."
          }
        },
        "additionalProperties": false,
        "description": "Information for uploading an attachment using a pre-signed S3 URL."
      },
      "CallResult": {
        "enum": [
          "SPOKE",
          "NO_ANSWER",
          "LEFT_MESSAGE"
        ],
        "type": "string"
      },
      "OrderRequest": {
        "required": [
          "orderPlacedDate",
          "customerId",
          "storeId",
          "fulfillmentStatus",
          "orderFlow",
          "provider"
        ],
        "type": "object",
        "properties": {
          "storeId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "The unique identifier for the common organization (store).",
            "example": "bf11a6b9-b991-4360-ba46-f82e23a3273d, CoOrgTestId1, CoOrgTestId2"
          },
          "customerId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "The unique identifier for the consumer (connected customer) involved in this order.",
            "example": "bf11a6b9-b991-4360-ba46-f82e23a3273d"
          },
          "consumerName": {
            "type": "string",
            "description": "The full name of the consumer pertaining to this order.",
            "nullable": true,
            "example": "John Smith"
          },
          "agentId": {
            "type": "string",
            "description": "The unique identifier for the common user (bridge) involved in this order.",
            "nullable": true,
            "example": "BRIDGE_ID123"
          },
          "agentName": {
            "type": "string",
            "description": "The full name of the common user.",
            "nullable": true,
            "example": "Jane Smith"
          },
          "orderFlow": {
            "$ref": "#/components/schemas/DirectionType"
          },
          "content": {
            "type": "string",
            "description": "The primary content of the order. Common content field between all order types.\r\n<remarks><list type=\"bullet\"><item><description>`SHIPMENT` - order body</description></item><item><description>`TEXT` - digital order content</description></item><item><description>`CALL` - direct order content</description></item></list></remarks>",
            "nullable": true
          },
          "mediaIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of Common Order Media identifiers associated with this order.\r\n<remarks>\r\nMaximum of 50 media IDs allowed, with each ID limited to 50 characters.\r\n</remarks>",
            "nullable": true,
            "example": [
              "media123",
              "media456"
            ]
          },
          "orderPlacedDate": {
            "type": "string",
            "description": "The date and time (with offset) when the order was sent.",
            "format": "date-time",
            "example": "2024-01-15T09:00:00-05:00 or 2024-01-15T10:30:00Z"
          },
          "orderFulfilledDate": {
            "type": "string",
            "description": "The date and time (with offset) when the order was successfully delivered.\r\n\r\n<remarks>\r\nIf DeliveryStatus is set to `SUCCESS`, this field becomes required and must be provided.\r\nFor other statuses, this field should be omitted or null.\r\n</remarks>",
            "format": "date-time",
            "nullable": true,
            "example": "2024-01-15T09:00:00-05:00 or 2024-01-15T10:30:15Z"
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "tenantId": {
            "type": "string",
            "description": "The unique identifier for the (common organization) tenant.",
            "nullable": true,
            "example": "TENANT123"
          },
          "fulfillmentStatus": {
            "$ref": "#/components/schemas/DeliveryStatus"
          },
          "solution": {
            "$ref": "#/components/schemas/Solution"
          }
        },
        "additionalProperties": false,
        "description": "The base order request model for the ingestion APIs.\r\n<remarks>\r\nThis model has common order properties shared across all channel types.</remarks>"
      },
      "OrderResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string",
            "description": "The unique identifier for the order.",
            "example": "68e433dd6d302b9378615fd9"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentUploadInfo"
            },
            "description": "Pre-signed S3 URLs for uploading attachments. Null if no attachments or on duplicate/idempotency responses. Order matches request attachment array.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "The order response model for the ingestion APIs.\r\n<remarks>\r\nThis model returns the unique identifier for the order.</remarks>"
      },
      "fulfillmentStatus": {
        "enum": [
          "SUCCESS",
          "IN_PROGRESS",
          "FAILURE"
        ],
        "type": "string",
        "description": "Represents the current delivery status of a order message.\r\n<remarks>\r\nWhen set to `SUCCESS`, the OrderFulfilledDate field is required.</remarks>"
      },
      "OrderFlowType": {
        "enum": [
          "INBOUND",
          "OUTBOUND"
        ],
        "type": "string",
        "description": "Specifies the direction of order flow between the business and the customer.\r\n<remarks>\r\nFrom the user perspective:<list type=\"bullet\"><item><description>`INBOUND` - From the customer; To the user.</description></item><item><description>`OUTBOUND` - From the user; To the customer.</description></item></list></remarks>"
      },
      "DuplicateOrderResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string",
            "description": "The unique identifier for the existing order this request was a duplicate of",
            "example": "68e433dd6d302b9378615fd9"
          }
        },
        "additionalProperties": false,
        "description": "The duplicate order response model for the ingestion APIs. This is returned when an ingestion request comes in that matches an already ingested order.\r\n<remarks>\r\nMatches are determined by order provider information, namely the Channel Type, Provider's Name, and Provider's Order ID.</remarks>"
      },
      "AddressInfo": {
        "required": [
          "address"
        ],
        "type": "object",
        "properties": {
          "address": {
            "minLength": 1,
            "type": "string",
            "description": "The address for a party (sender or recipient) tied to the shipment order.",
